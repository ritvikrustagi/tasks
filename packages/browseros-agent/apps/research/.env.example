# Copy to .env (gitignored). Never put provider secrets in VITE_ variables.
PORT=4318
RESEARCH_ORIGIN=http://127.0.0.1:4318
RESEARCH_DB=./data/research.sqlite
LINKUP_API_KEY=
NEBIUS_API_KEY=
# Choose an available model from your Token Factory account.
NEBIUS_MODEL=
# Local runs use the real Linkup and Nebius APIs but do not count as Render execution.
RESEARCH_EXECUTOR=local
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=
# Set the same randomly generated secret on the web and workflow services.
RESEARCH_WORKER_SECRET=
# Public URL of the web service; workflow steps write durable checkpoints here.
RESEARCH_API_URL=
# Required for a public deployment. Share with demo participants separately.
RESEARCH_ACCESS_CODE=
# Enables the explicit fail-once demo control.
RESEARCH_ALLOW_FAILURE_DEMO=false

# Sell my stuff: choose a Nebius model that accepts image input and structured JSON.
# Set these on both web and workflow services when using Render.
NEBIUS_VISION_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional alternate image/listing-writing provider from Offload's research branch.
PIONEER_API_KEY=
PIONEER_MODEL=
PIONEER_BASE_URL=https://api.pioneer.ai/v1
